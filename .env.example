# --- Public site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME="Ekatoris Art"

# --- Database (Neon / Supabase / local Postgres) ---
DATABASE_URL="postgresql://user:password@localhost:5432/ekatorissart?schema=public"

# --- Stripe ---
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...

# --- Order notification emails (Resend, https://resend.com) ---
# Without RESEND_API_KEY the notification is skipped with a console warning.
RESEND_API_KEY=
# Defaults to ekatorissart@outlook.com when unset.
ORDER_NOTIFY_EMAIL=ekatorissart@outlook.com
# Must be a Resend-verified sender. The onboarding@resend.dev default only
# delivers to the Resend account owner's email address.
ORDER_EMAIL_FROM="Ekatoris Art <onboarding@resend.dev>"

# --- Cloudflare R2 (S3-compatible image storage) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=ekatorissart
R2_PUBLIC_URL=https://pub-xxx.r2.dev

# --- Admin auth (simple password gate for MVP) ---
ADMIN_PASSWORD=change-me
